from pandas.plotting import parallel_coordinates
import matplotlib.pyplot as plt
import pandas as pd
import sqlalchemy as sa
import os
import geopandas as gpd
import numpy.typing as npt
import numpy as np
from math import sqrt
from requete import connexion
from requete import requete_sql

def coordonnees_paralleles(date_debut, date_fin, echelle, nom_zone=None):

    df_incendie, titre_zone, _ = requete_sql(date_debut, date_fin, 'incendie', echelle, nom_zone)
    df_inondation, _, _ = requete_sql(date_debut, date_fin, 'incendie', echelle, nom_zone)

    for df in [df_incendie, df_inondation]:
        df['DTJ_DATE_DEBUT'] = pd.to_datetime(df['DTJ_DATE_DEBUT'])
        df['ANNEE'] = df['DTJ_DATE_DEBUT'].dt.year.astype(str)
    df_inc_agg = df_incendie.groupby('ANNEE')['DNN_VALEUR'].sum().reset_index()
    df_ino_agg = df_inondation.groupby('ANNEE')['DNN_VALEUR'].sum().reset_index()

    df_final = pd.merge(df_inc_agg, df_ino_agg, on='ANNEE', how='outer').fillna(0)
    df_final.columns = ['ANNEE', 'Incendies', 'Inondations']

    plt.figure(figsize=(10, 6))
    
    
    parallel_coordinates(df_final, class_column='ANNEE', colormap='viridis')
    
    plt.title(f'Profil des risques par année - {titre_zone}')
    plt.show()
    plt.close()

coordonnees_paralleles('19900101', '20200201', 'region')